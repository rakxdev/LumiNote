{
  "name": "luminote",
  "version": "4.7.0",
  "description": "LumiNote v04 - Production-hardened real-time speech intelligence app with Link Mode cross-device sync",
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev public",
    "dev:sync": "wrangler dev --config worker/wrangler.toml",
    "deploy": "wrangler pages deploy public",
    "deploy:sync": "wrangler deploy --config worker/wrangler.toml",
    "test": "node --test tests/**/*.test.js",
    "lint": "eslint .",
    "check:fast": "npm run lint && node scripts/floor-guard.mjs",
    "check:task": "npm test && node scripts/check-ratchets.mjs",
    "check:full": "npm run check:fast && npm run check:task && node scripts/floor-guard.mjs --base origin/master"
  },
  "keywords": [
    "speech-to-text",
    "assemblyai",
    "deepgram",
    "audioworklet",
    "cloudflare-pages"
  ],
  "author": "Rakxdev",
  "license": "MIT",
  "devDependencies": {
    "eslint": "^8.56.0",
    "miniflare": "^4.20260730.0",
    "wrangler": "^4.131.1"
  },
  "dependencies": {
    "otpauth": "^9.5.2"
  }
}
